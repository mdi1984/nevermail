<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Nevermail.Aspire.Hosting</PackageId>
    <Authors>Markus Dietrich</Authors>
    <Description>.NET Aspire hosting integration for Nevermail, a local mock for SendGrid, Brevo, Mailchimp Transactional (Mandrill), Azure Communication Services Email, AhaSend and SMTP. Every mail your app sends ends up in a web UI instead of an inbox.</Description>
    <PackageTags>aspire;hosting;email;mock;sendgrid;brevo;sendinblue;mandrill;mailchimp;azure;acs;communication-services;ahasend;smtp;testing</PackageTags>
    <RepositoryUrl>https://github.com/mdi1984/nevermail</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mdi1984/nevermail</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Image tag the integration uses by default. Release builds pass the git tag, e.g. -p:NevermailImageTag=v1.2.0 -->
    <NevermailImageTag Condition="'$(NevermailImageTag)' == ''">latest</NevermailImageTag>
  </PropertyGroup>

  <ItemGroup>
    <!-- Any Aspire 13.x. Builds against the lowest version in the range, so only APIs every 13.x has are used;
         app hosts on newer 13.x versions keep their own version. -->
    <PackageReference Include="Aspire.Hosting" Version="[13.0.0, 14.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NevermailImageTag" Value="$(NevermailImageTag)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
